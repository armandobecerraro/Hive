# The Hive — LLM real (gratis con registro en varios proveedores)
# Copia:  cp hive_core/.env.example hive_core/.env  (o .env en la raíz del repo Hive)
# Pega tu clave. No subas .env a git.
#
# Trabajo real (La Reina + obreras escriben código): configura Opción A o B abajo.
# NO definas HIVE_USE_MOCK_LLM=1 salvo pruebas automatizadas o máquina sin red.

# ── Opción A: OpenRouter — modelos :free (p. ej. meta-llama/llama-3.2-3b-instruct:free)
# Crea clave en https://openrouter.ai/keys
HIVE_OPENAI_BASE_URL=https://openrouter.ai/api/v1
HIVE_OPENAI_API_KEY=sk-or-v1-REEMPLAZA_TU_CLAVE
HIVE_OPENAI_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Recomendado por OpenRouter (opcional, mejora cuotas / ranking)
HIVE_OPENAI_HTTP_REFERER=https://github.com
HIVE_OPENAI_APP_TITLE=The Hive

# ── Opción B: Groq — muy rápido, tier gratuito con cuenta en https://console.groq.com
# Descomenta y comenta la opción A si prefieres Groq:
# HIVE_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# HIVE_OPENAI_API_KEY=gsk_REEMPLAZA_TU_CLAVE
# HIVE_OPENAI_MODEL=llama-3.1-8b-instant
# HIVE_OPENAI_HTTP_REFERER=
# HIVE_OPENAI_APP_TITLE=

# ── Ollama local (opcional; si está definido, tiene prioridad sobre lo anterior)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
