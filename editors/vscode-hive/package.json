{
  "name": "hive-vscode",
  "displayName": "Hive — La Colmena",
  "description": "Panel de misión y ciclo La Reina (hive_core). Compatible con VS Code, Cursor, Windsurf y cualquier IDE que use el Extension Host estándar.",
  "version": "0.1.0",
  "publisher": "hive",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/armandobecerraro/Hive.git",
    "directory": "editors/vscode-hive"
  },
  "homepage": "https://github.com/armandobecerraro/Hive/tree/main/editors/vscode-hive",
  "bugs": {
    "url": "https://github.com/armandobecerraro/Hive/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hive",
    "git",
    "automation",
    "orchestration",
    "cursor",
    "windsurf",
    "vscode",
    "open-vsx"
  ],
  "activationEvents": [
    "onCommand:hive.openChat",
    "onCommand:hive.runCycle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hive.openChat",
        "title": "Hive: Abrir panel de misión",
        "category": "Hive",
        "icon": "$(hubot)"
      },
      {
        "command": "hive.runCycle",
        "title": "Hive: Ejecutar ciclo (hive.request.json actual)",
        "category": "Hive"
      }
    ],
    "configuration": {
      "title": "Hive",
      "properties": {
        "hive.executablePath": {
          "type": "string",
          "default": "",
          "description": "Ruta absoluta al binario hive_core. Vacío = buscar \"hive_core\" en PATH."
        },
        "hive.showTerminalOnRun": {
          "type": "boolean",
          "default": false,
          "description": "Si es true, también muestra la salida en la terminal integrada."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "hive.openChat",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "hive.runCycle",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/hiveRunner.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
