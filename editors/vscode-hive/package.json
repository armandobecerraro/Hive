{
  "name": "hive-vscode",
  "displayName": "Hive — La Colmena",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "hive",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/armandobecerraro/Hive.git",
    "directory": "editors/vscode-hive"
  },
  "homepage": "https://github.com/armandobecerraro/Hive/tree/main/editors/vscode-hive",
  "bugs": {
    "url": "https://github.com/armandobecerraro/Hive/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hive",
    "git",
    "automation",
    "orchestration",
    "cursor",
    "windsurf",
    "vscode",
    "open-vsx"
  ],
  "activationEvents": [
    "onCommand:hive.openChat",
    "onCommand:hive.runCycle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hive.openChat",
        "title": "%command.openChat%",
        "category": "Hive",
        "icon": "$(hubot)"
      },
      {
        "command": "hive.runCycle",
        "title": "%command.runCycle%",
        "category": "Hive"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "hive.executablePath": {
          "type": "string",
          "default": "",
          "description": "%config.executablePath%"
        },
        "hive.showTerminalOnRun": {
          "type": "boolean",
          "default": false,
          "description": "%config.showTerminal%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "hive.openChat",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "hive.runCycle",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/hiveRunner.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^6.0.2"
  }
}
